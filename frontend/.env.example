# ==============================================================================
# HBB Mutation Analyzer - Frontend Environment Configuration (.env.local)
# ==============================================================================
# Local Development:
#   Defaults to http://localhost:8000 when unset.
#
# Netlify Production:
#   Configure in Netlify Site Settings > Environment Variables:
#   NEXT_PUBLIC_API_URL=https://<your-render-backend-service>.onrender.com
#
# SECURITY NOTE:
#   Do NOT add backend secrets (GROQ_API_KEY, NCBI_API_KEY, NCBI_EMAIL) here.
#   All LLM inference and NCBI fetching remain exclusively on the Render backend.
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
