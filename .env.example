# HBB Mutation Analyzer Environment Configuration

# Backend API Settings
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Groq API Key (Required for AI Research Copilot synthesis)
# The application functions in fully deterministic fallback mode if this is omitted.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# NCBI E-utilities Credentials (Optional but recommended to prevent strict rate limiting)
# NCBI allows 3 req/sec without key, 10 req/sec with key
NCBI_EMAIL=researcher@example.edu
NCBI_API_KEY=your_ncbi_api_key_here

# Reference and Data paths
DATA_DIR=data
REFERENCE_FILE=data/reference/NM_000518.5.fasta
