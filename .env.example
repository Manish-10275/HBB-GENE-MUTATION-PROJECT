# ==============================================================================
# HBB Mutation Analyzer - Environment Configuration (.env)
# ==============================================================================
# Copy this template to '.env' in the project root:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# NOTE: The core bioinformatics engine, sequence alignment, codon translation,
# ClinVar/PubMed retrieval, and deterministic Research Copilot work 100% locally
# without any paid services or external cloud dependencies.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (Backend on Render / Local Execution)
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
# Production Frontend Origin (Configure in Render Dashboard with your Netlify site URL):
# FRONTEND_ORIGIN=https://your-site.netlify.app
# Additional CORS origins (Comma-separated or JSON list; localhost:3000 is always allowed by default):
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. LIVE AI SYNTHESIS (Optional - Groq API)
# ------------------------------------------------------------------------------
# Required ONLY if you want live natural language synthesis from Groq.
# If omitted or left empty, the application functions in 100% deterministic,
# zero-hallucination offline fallback mode with authoritative evidence packets.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. EXTERNAL DATABASE RETRIEVAL (Optional - NCBI E-Utilities)
# ------------------------------------------------------------------------------
# Used when querying NCBI ClinVar and PubMed directly over the internet.
# NCBI allows 3 requests/sec without a key, and 10 requests/sec with an API key.
# If internet access is unavailable, verified offline fallback fixtures are used.
NCBI_EMAIL=researcher@example.edu
NCBI_API_KEY=your_ncbi_api_key_here

# ------------------------------------------------------------------------------
# 4. REFERENCE AND DATA DIRECTORIES (Optional - Defaults to local folders)
# ------------------------------------------------------------------------------
DATA_DIR=data
REFERENCE_FILE=data/reference/NM_000518.5.fasta

