# HBB Mutation Analyzer Environment Configuration

# Backend API Settings
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OpenAI API Key (Required for AI Research Copilot synthesis)
# The application functions in fully deterministic mode if this is omitted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NCBI E-utilities Credentials (Optional but recommended to prevent strict rate limiting)
# NCBI allows 3 req/sec without key, 10 req/sec with key
NCBI_EMAIL=researcher@example.edu
NCBI_API_KEY=

# Reference and Data paths
DATA_DIR=data
REFERENCE_FILE=data/reference/NM_000518.5.fasta
