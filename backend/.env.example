# ==============================================================================
# HBB Mutation Analyzer - Backend Environment Configuration (.env)
# ==============================================================================
# In local development: defaults to localhost and offline deterministic engine.
# In Render production: configure in Render Dashboard > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (Render / Local)
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
# Production Frontend Origin (Configure in Render Dashboard with your Netlify site URL):
# FRONTEND_ORIGIN=https://your-site.netlify.app
# Additional CORS origins (Comma-separated or JSON list; localhost:3000 is always allowed by default):
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. LIVE AI SYNTHESIS (Optional - Groq API)
# ------------------------------------------------------------------------------
# Required ONLY if you want live natural language synthesis from Groq.
# If omitted, deterministic offline fallback mode activates automatically.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. EXTERNAL DATABASE RETRIEVAL (Optional - NCBI E-Utilities)
# ------------------------------------------------------------------------------
NCBI_EMAIL=researcher@example.edu
NCBI_API_KEY=your_ncbi_api_key_here

# ------------------------------------------------------------------------------
# 4. REFERENCE AND DATA DIRECTORIES (Optional)
# ------------------------------------------------------------------------------
DATA_DIR=data
REFERENCE_FILE=data/reference/NM_000518.5.fasta
